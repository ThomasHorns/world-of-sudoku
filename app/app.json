{
  "expo": {
    "name": "World of Sudoku",
    "slug": "world-of-sudoku",
    "owner": "mchorn-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "mchorn.worldofsudoku",
      "requireFullScreen": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.game-center": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#185FA5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "mchorn.worldofsudoku"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#2C2C2A"
          }
        }
      ],
      "expo-iap",
      [
        "react-native-google-mobile-ads",
        {
          "iosAppId": "ca-app-pub-3041624447235807~3132374765",
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "userTrackingUsageDescription": "Your data is used to show you more relevant ads. The ads keep World of Sudoku free.",
          "skAdNetworkItems": [
            "cstr6suwn9.skadnetwork"
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a8e7b702-35ce-4224-888c-6dc73b7eecbd"
      }
    }
  }
}
